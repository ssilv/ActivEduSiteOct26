# Portalul intern (părinți, catalog, administrare).
# Local, de exemplu: http://localhost:3001
# Producție, de exemplu: https://app.domeniu.ro
NEXT_PUBLIC_APP_PORTAL_URL="https://app.domeniu.ro"

